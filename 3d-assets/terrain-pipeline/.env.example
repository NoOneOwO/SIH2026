# DamSafe Twin — terrain pipeline credentials.
# Copy to .env (never commit real keys). Key ONLY from this file / env vars.
# Get keys at https://portal.opentopography.org/ (free account → API key).
# Each team member can create their OWN legitimate key — pool them here so
# the pipeline rotates when one key hits its quota (no key is ever logged).

OPENTOPOGRAPHY_API_KEY=paste_your_key_here

# Recommended for batch runs: several legitimate keys (rotation/fallback).
# Any / all of these forms work and combine (duplicates ignored):
# OPENTOPOGRAPHY_API_KEY_1=paste_key_1_here
# OPENTOPOGRAPHY_API_KEY_2=paste_key_2_here
# OPENTOPO_KEYS=paste_key_1_here,paste_key_2_here,paste_key_3_here

# Optional: local DEM cache dir (defaults to ./cache next to the pipeline).
# Cached DEMs are reused and never redownloaded while valid.
OPENTOPO_CACHE_DIR=./cache

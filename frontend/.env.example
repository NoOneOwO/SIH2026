# DamSafe Twin — frontend environment (copy to .env for local dev)
# All keys are OPTIONAL. The app starts keyless (Esri satellite + OSM fallback).

# Backend API base (empty = same origin / Vite dev proxy to localhost:8000)
VITE_API_BASE_URL=

# Cesium ion token → unlocks the "ion" basemap stack + world terrain in
# God's Eye 3D. Free Community plan = eligible personal, non-commercial use
# with quotas. Get one at https://cesium.com/ion (use a public assets:read
# token). Without it, Esri World Imagery + ellipsoid terrain is used.
VITE_CESIUM_ION_TOKEN=

# DamSafe Twin — backend environment template.
# Copy to backend/.env for local (non-Docker) runs. NEVER commit real secrets.
# In Docker, values come from compose environment / shell env, not this file.

# --- Copernicus Data Space S3 (terrain provider: CDSE SRTM fallback) ---
# Create at the CDSE S3 credentials manager (secret is shown ONCE — store it
# in your shell/.env only, never in git or chat).
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=

# --- OpenTopography (optional LAST-RESORT terrain fallback only) ---
OPENTOPOGRAPHY_API_KEY=

# --- AI assistant LLM (Groq first, generic OpenAI-compatible fallback) ---
# Grab a free key at https://console.groq.com/keys and export it here.
# Without any key the assistant answers from the curated dam knowledge base
# (prototype still works; replies are labeled with their source).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# --- Local official auth (JWT signing; set a strong value in production) ---
# DAMSAFE_AUTH_SECRET=change-me-to-a-long-random-string

# --- Sandbox terrain locations (Docker sets these via compose) ---
# DAMSAFE_TERRAIN_DIR=/data/terrain
# DAMSAFE_DEM_CACHE=/data/dem-cache
